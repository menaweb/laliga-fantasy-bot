# Cuenta de LaLiga Fantasy.
# - Si entras con Google/Apple/Facebook: deja los dos vacíos. `python main.py login` abrirá el navegador.
# - Si tu cuenta es de email + contraseña: rellénalos y el login será automático.
LALIGA_EMAIL=
LALIGA_PASSWORD=

# Opcional: ID de la liga a gestionar (por defecto la de config.yaml).
LALIGA_LEAGUE_ID=

# Clave de cifrado del refresh token en state/auth.enc. La genera `python main.py push-token --set-key`
# y debe ser la misma que el secret STATE_KEY del repo de GitHub.
STATE_KEY=

# Opcional en local: avisos por Telegram (en CI van como secrets).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
